; Zona RAIZ fictícia do laboratório
$TTL 86400
@       IN SOA  a.root-servers.lab. hostmaster.nic.lab. (
                2026102801 ; serial
                1800       ; refresh
                900        ; retry
                604800     ; expire
                86400 )    ; TTL de cache negativo
        IN NS   a.root-servers.lab.

; ---- Delegação do TLD .lab ---------------------------------------------
lab.                IN NS   ns1.nic.lab.

; ---- Glue ---------------------------------------------------------------
; Os nomes dos servidores ficam DENTRO da zona delegada (.lab).
; Sem estes endereços, ninguém conseguiria chegar até eles (dependência circular).
ns1.nic.lab.        IN A    10.53.0.20
a.root-servers.lab. IN A    10.53.0.10
