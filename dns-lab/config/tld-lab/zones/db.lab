; Zona do TLD .lab
$TTL 86400
@       IN SOA  ns1.nic.lab. hostmaster.nic.lab. (
                2026102801 ; serial
                1800       ; refresh
                900        ; retry
                604800     ; expire
                3600 )     ; TTL de cache negativo
        IN NS   ns1.nic.lab.

ns1.nic             IN A    10.53.0.20
a.root-servers      IN A    10.53.0.10

; ---- Delegação de sd.lab -------------------------------------------------
sd                  IN NS   ns1.sd.lab.
sd                  IN NS   ns2.sd.lab.

; ---- Glue ---------------------------------------------------------------
ns1.sd              IN A    10.53.0.30
ns2.sd              IN A    10.53.0.31
